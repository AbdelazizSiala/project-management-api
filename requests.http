### Sta3mlt REST Client directly fil VS Code fi 3odh Bruno wela Postman bech njm ntesti el API mta3i

### Register
POST http://localhost:3000/register
Content-Type: application/json

{
    "nom": "Ahmed",
    "login": "ahmed12",
    "password": "123"
}

### Login Aziz
POST http://localhost:3000/login
Content-Type: application/json

{
    "login": "aziz123",
    "password": "123"
}

### Login Ahmed
POST http://localhost:3000/login
Content-Type: application/json

{
    "login": "ahmed12",
    "password": "123"
}


### Create project
POST http://localhost:3000/projects
Authorization: Bearer YOUR_USER_TOKEN
Content-Type: application/json

{
    "nom": "My Second Project",
    "description": "Hello world"
}

### Get projects
GET http://localhost:3000/projects
Authorization: Bearer YOUR_MANAGER_TOKEN

### Update project
PATCH http://localhost:3000/projects/YOUR_PROJECT_ID
Authorization: Bearer YOUR_USER_TOKEN
Content-Type: application/json

{
    "nom": "Test 2",
    "description": "Test 2 description",
    "status": "completed"
}

### Delete project
DELETE http://localhost:3000/projects/YOUR_PROJECT_ID
Authorization: Bearer YOUR_USER_TOKEN


### Create a task
POST http://localhost:3000/tasks
Content-Type: application/json
Authorization: Bearer YOUR_USER_TOKEN

{
    "title": "Test",
    "description": "Test description",
    "status": "doing",
    "deadline": "2026-12-01",
    "project": "YOUR_PROJECT_ID"
}

### Get all tasks
GET http://localhost:3000/tasks
Authorization: Bearer YOUR_USER_TOKEN


### Update task
PATCH http://localhost:3000/tasks/YOUR_TASK_ID
Content-Type: application/json
Authorization: Bearer YOUR_USER_TOKEN

{
    "title": "Updated task title",
    "description": "Updated description",
    "status": "doing",
    "deadline": "2026-12-15"
}

### Delete task
DELETE http://localhost:3000/tasks/YOUR_TASK_ID
Authorization: Bearer YOUR_USER_TOKEN


### Assign task to user
PATCH http://localhost:3000/tasks/YOUR_TASK_ID/assign
Content-Type: application/json
Authorization: Bearer YOUR_MANAGER_TOKEN

{
    "assignedTo": "YOUR_USER_ID"
}


### Search projects by name or description
GET http://localhost:3000/projects?search=testing
Authorization: Bearer YOUR_USER_TOKEN

### Filter projects by status
GET http://localhost:3000/projects?status=in%20progress
Authorization: Bearer YOUR_USER_TOKEN

### Sort projects by name
GET http://localhost:3000/projects?sortBy=nom&order=asc
Authorization: Bearer YOUR_USER_TOKEN

### Combine project filters
GET http://localhost:3000/projects?search=testing&status=in%20progress&sortBy=createdAt&order=desc
Authorization: Bearer YOUR_USER_TOKEN

### Search tasks by title or description
GET http://localhost:3000/tasks?search=my
Authorization: Bearer YOUR_USER_TOKEN

### Filter tasks by status
GET http://localhost:3000/tasks?status=todo
Authorization: Bearer YOUR_USER_TOKEN

### Filter tasks by deadline
GET http://localhost:3000/tasks?deadlineFrom=2026-11-01&deadlineTo=2026-12-31
Authorization: Bearer YOUR_USER_TOKEN

### Sort tasks by deadline
GET http://localhost:3000/tasks?sortBy=deadline&order=asc
Authorization: Bearer YOUR_USER_TOKEN

### Filter tasks by assigned user
GET http://localhost:3000/tasks?assignedTo=YOUR_USER_ID
Authorization: Bearer YOUR_MANAGER_TOKEN

### Combine task filters
GET http://localhost:3000/tasks?status=todo&sortBy=deadline&order=asc
Authorization: Bearer YOUR_MANAGER_TOKEN

### Register without a name
POST http://localhost:3000/register
Content-Type: application/json

{
    "login": "testuser",
    "password": "123456"
}

### Create a project without a name
POST http://localhost:3000/projects
Authorization: Bearer YOUR_MANAGER_TOKEN
Content-Type: application/json

{
    "description": "Testing validation"
}

### Create a task with an invalid status
POST http://localhost:3000/tasks
Authorization: Bearer YOUR_MANAGER_TOKEN
Content-Type: application/json

{
    "title": "Test task",
    "description": "Testing invalid status",
    "status": "invalid_status",
    "deadline": "2026-12-01",
    "project": "YOUR_PROJECT_ID"
}

### Update a project using an invalid ID
PATCH http://localhost:3000/projects/123
Authorization: Bearer YOUR_MANAGER_TOKEN
Content-Type: application/json

{
    "nom": "Updated project"
}

### Sending a request to a non-existent route
GET http://localhost:3000/random